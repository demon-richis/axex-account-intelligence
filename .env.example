# Required for authenticated requests
API_KEY=replace-with-a-long-random-secret

# Optional production database
DATABASE_URL=postgresql://user:password@host/database?sslmode=require

PORT=3000
TRUST_PROXY=
# 1 or a positive proxy hop count; leave blank outside a trusted reverse proxy.
JOIN_WAVE_MIN=3
RATE_LIMIT_PUBLIC=60
RATE_LIMIT_AUTH=600
# Comma-separated browser origins. Leave empty for server-to-server use.
CORS_ORIGINS=
HIGH_RISK_COUNTRIES=RU,KP,IR
SHARED_NETWORK_ASNS=
SHARED_NETWORK_ISPS=
# Retention windows for privacy and bounded storage. Cleanup runs once per day.
BEHAVIOR_RETENTION_DAYS=180
NETWORK_RETENTION_DAYS=90
OUTCOME_RETENTION_DAYS=365
IP_LOOKUP_URL=https://ipwho.is/{ip}
IP_LOOKUP_FIELDS=success,country_code,connection,security
# Optional. When set, analysis attempts Discord enrichment but never depends on it.
# DISCORD_TOKEN=replace-with-server-side-bot-token
